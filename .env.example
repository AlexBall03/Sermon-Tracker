# Sermon Tracker environment variables
#
# Copy this file to .env.local and fill in DEVELOPMENT values only.
# Never commit real values. See docs/ENVIRONMENTS.md for where each one comes from.

# Clerk (development instance)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Neon (development branch) and which database the URL points at.
# DATABASE_ENVIRONMENT must be "development" here; "production" is refused locally.
DATABASE_URL=
DATABASE_ENVIRONMENT=development

# Clerk user ID (user_...) of the first administrator in this Clerk instance.
INITIAL_ADMIN_CLERK_USER_ID=

# Optional, for the signed-in end-to-end tests (tests/e2e/library.spec.ts).
# The email address of a user in the development Clerk instance who has been
# admitted to the application. Left empty, those tests are skipped. No password
# is needed, and this must never name a production account.
# E2E_CLERK_USER_EMAIL=

# Production migrations only. Do NOT put this in .env.local.
# Set it in your shell, or in .env.production.local (git-ignored), when running
# `npm run db:migrate:prod` or `npm run db:stamp -- prod`.
# PRODUCTION_DATABASE_URL=
